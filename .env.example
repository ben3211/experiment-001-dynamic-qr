# Copy to worker/.dev.vars for local development (never commit real values).
# Wrangler loads .dev.vars automatically during `wrangler dev`.

# Public URLs (optional overrides; defaults are in wrangler.toml)
# BASE_URL=http://localhost:8787
# FRONTEND_URL=http://localhost:5173

# Stripe test-mode credentials (Dashboard → Developers → API keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Local webhook forwarding:
# stripe listen --forward-to localhost:8787/api/stripe/webhook
